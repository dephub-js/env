{
  "name": "@dephub/env",
  "type": "module",
  "version": "1.0.5",
  "description": "Environment variable management with .env file support, shell export generation, and process environment integration",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "env": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "release": "pnpm publish",
    "docs": "lineo md 'src/**/*.ts' --outFile code.md --outDir temp",
    "test": "node --test",
    "check": "pnpm fmt && pnpm lint && pnpm check-types",
    "check-types": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --fix --max-warnings 0",
    "fmt": "prettier --write .",
    "clean": "rm -rf dist",
    "prepack": "pnpm check && pnpm build",
    "pack": "pnpm pack",
    "build": "vite build",
    "dev": "vite build -w --mode development"
  },
  "keywords": [
    "env",
    "environment",
    "variables",
    "dotenv",
    "shell",
    "bash",
    "powershell",
    "fish",
    "zsh",
    "typescript",
    "nodejs",
    "dephub"
  ],
  "author": {
    "name": "Estarlin R",
    "email": "dev@estarlincito.com",
    "url": "https://estarlincito.com"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dephub-js/env#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dephub-js/env.git"
  },
  "bugs": {
    "url": "https://github.com/dephub-js/env/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dephub/command": "^3.0.2",
    "@dephub/logger": "^1.3.0"
  },
  "devDependencies": {
    "@dephub/eslint-ts": "^1.0.6",
    "@dephub/glob": "^1.0.3",
    "@dephub/path": "^2.0.1",
    "@types/node": "^26.6.9",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
